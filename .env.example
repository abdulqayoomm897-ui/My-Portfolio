# Copy to .env.local for local dev. Add the same keys in Vercel → Project → Settings → Environment Variables.

# Resend — https://resend.com (API key stays server-side only)
RESEND_API_KEY=re_xxxxxxxx

# Where contact form submissions are delivered
CONTACT_TO_EMAIL=abdulqayoomm897@gmail.com

# "From" must use a domain you verified in Resend (production).
# For quick tests without a domain, Resend allows: Portfolio <onboarding@resend.dev>
# (sending may be limited — verify your domain for production).
RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>
